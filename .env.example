# =========================================================
# DropDoor Backend - Local Environment
# =========================================================

# ---------------------------------------------------------
# Django
# ---------------------------------------------------------

SECRET_KEY=change-this-to-a-long-random-secret-key
DEBUG=1

ALLOWED_HOSTS=127.0.0.1,localhost


# ---------------------------------------------------------
# CORS
# ---------------------------------------------------------

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ---------------------------------------------------------
# PostgreSQL - Local
# ---------------------------------------------------------

DB_NAME=dropdoor
DB_USER=dropdoor
DB_PASSWORD=dropdoor
DB_HOST=localhost
DB_PORT=5432


# ---------------------------------------------------------
# Order / Delivery
# ---------------------------------------------------------

DELIVERY_INSIDE=60
DELIVERY_SUB=100
DELIVERY_OUTSIDE=120
MIN_WITHDRAW=500
HOLD_DAYS=0
# Taka a referrer earns per delivered order of a reseller who joined with their Dropship ID (0 = off). Changeable in the admin panel Settings.
REFERRAL_BONUS=0


# ---------------------------------------------------------
# SMS - BulkSMSBD
# ---------------------------------------------------------
# 0 = Real SMS
# 1 = Mock

SMS_MOCK=0

SMS_API_KEY=YOUR_REAL_BULKSMSBD_API_KEY
SMS_SENDER_ID=YOUR_APPROVED_SENDER_ID
SMS_URL=http://bulksmsbd.net/api/smsapi

# ---------------------------------------------------------
# Added in v2 (all optional)
# ---------------------------------------------------------
# Admin login created on every deploy (default dropdoor / dropdoor)
ADMIN_USER=dropdoor
# ADMIN_PASSWORD=dropdoor
# SMS: SMS_API_KEY and SMS_SENDER_ID are required (no built-in key any more). On Render add them under Environment.
# Render sets DATABASE_URL by itself. Locally the DB_* values above are used.

# ---------------------------------------------------------
# Supabase Storage (product photos and sub category icons)
# ---------------------------------------------------------
# Leave SUPABASE_URL empty to keep images in the database (local development only).
# On Render add these three under Environment. SUPABASE_SERVICE_KEY is a SECRET: never commit it, never put it in the app.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=product-images
SUPABASE_ICON_BUCKET=icons

# ---------------------------------------------------------
# Activity logs (Django admin > Reseller logs / Admin logs). Kept for 30 days, then deleted automatically.
# ---------------------------------------------------------
# ACTIVITY_LOG=0   switches the logs off completely
# LOG_READS=0      stores only the calls that change something, not the screens a reseller opens
